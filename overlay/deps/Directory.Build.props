<Project>
  <!-- Shared settings for the decompiled dependency libraries, rebuilt against FNA instead of XNA. -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0612;CS0618;CS0649;CS0659;CS0660;CS0661;CS1998;CS8981</NoWarn>
    <FnaProject>$(MSBuildThisFileDirectory)..\..\FNA\FNA.NetFramework.csproj</FnaProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="$(FnaProject)" />
  </ItemGroup>
</Project>
