<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generates the C# source of the game's XML serializers (what sgen.exe would), so the game can use
    them instead of building serializers at run time. Runs on .NET Framework, whose XmlSerializer
    code generator writes C#; loads the game build by reflection (path on the command line).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Xml" />
  </ItemGroup>
</Project>
