<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the Vita port's game assemblies from the player's own Stardew Valley 1.6.15 (compatibility branch). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Runs on a newer .NET too when only that is installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same decompiler as ilspycmd 11.1.0.9782, which the patches were made against. -->
    <PackageReference Include="ICSharpCode.Decompiler" Version="[11.1.0.9782]" />
    <!-- Unpacks the VitaSDK's .xz packages: Windows 10's tar.exe can't (it asks for an xz program it doesn't have). -->
    <PackageReference Include="SharpCompress" Version="[0.50.5]" />
  </ItemGroup>
</Project>
