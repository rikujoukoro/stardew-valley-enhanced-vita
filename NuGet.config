<?xml version="1.0" encoding="utf-8"?>
<!-- The builder's own package source, whatever the PC's NuGet settings say: without a source (a machine-wide
     NuGet.Config that clears them, an offline Visual Studio setup), restoring the builder fails with NU1100. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
