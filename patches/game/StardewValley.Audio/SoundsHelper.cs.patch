+	/// <summary>How many times one cue may start in a single update tick.</summary>
+	/// <remarks>
+	/// Port: cutting a patch of grass starts 'daggerswipe' once per weed in the same frame (10-20 times).
+	/// XACT honours the sound bank's instance limit by refusing the extra instances, so 3 play cleanly;
+	/// FAudio's limiting lets the instances replace each other within the frame and the result is
+	/// inaudible. Starting at most 3 per frame gives the XNA result on any audio backend.
+	/// </remarks>
+	public const int MaxSameCueStartsPerTick = 3;
+
+	private readonly System.Collections.Generic.Dictionary<string, int> _cueStartsThisTick = new System.Collections.Generic.Dictionary<string, int>();
+
+	private int _cueStartsTick = -1;
+
+	private bool TryCountSameFrameStart(string cueName)
+	{
+		if (_cueStartsTick != Game1.ticks)
+		{
+			_cueStartsTick = Game1.ticks;
+			_cueStartsThisTick.Clear();
+		}
+		_cueStartsThisTick.TryGetValue(cueName, out int starts);
+		if (starts >= MaxSameCueStartsPerTick)
+		{
+			return false;
+		}
+		_cueStartsThisTick[cueName] = starts + 1;
+		return true;
+	}
+
