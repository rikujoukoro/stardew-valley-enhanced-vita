+
+	/// <summary>Port: on the Vita the game's background tasks (load, save, new day) run on the calling thread.</summary>
+	/// <remarks>
+	/// Saving on a thread-pool thread ended in a fatal assertion in Mono's cooperative GC suspend
+	/// (a thread counted as stopped was already running at resume). The four Vita cores gain little from
+	/// it anyway, and every extra thread costs a stack. The callers only poll IsCompleted.
+	/// </remarks>
+	private static void StartOrRun(Task task)
+	{
+		if (VitaPlatform.IsVita)
+		{
+			task.RunSynchronously();
+		}
+		else
+		{
+			task.Start();
+		}
+	}
 }
