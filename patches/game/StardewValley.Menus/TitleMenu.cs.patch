+	private void DrawVitaModsButton(SpriteBatch b, Color tint)
+	{
+		ClickableTextureComponent button = buttons[3];
+		if (!button.visible || button.bounds.X >= Game1.uiViewport.Width)
+			return;
+		float scale = button.scale;
+		int row = button.sourceRect.Y;
+		Vector2 origin = new Vector2(37f, 29f);
+		Vector2 center = new Vector2(button.bounds.X + 37f * button.baseScale, button.bounds.Y + 29f * button.baseScale);
+		// 1. Native wooden button frame
+		b.Draw(titleButtonsTexture, center, new Rectangle(0, row, 74, 58), tint, 0f, origin, scale, SpriteEffects.None, 1f);
+		// 2. Clean inner cream rectangle covering the baked "New" word. The localized words reach sign pixels x7..64 and
+		// y10..38 (Turkish/Spanish/Italian, Russian), so cover the whole inside of the frame (x6..66, y9..47).
+		Vector2 innerTopLeft = center + new Vector2(-31f, -20f) * scale;
+		Vector2 innerSize = new Vector2(61f, 39f) * scale;
+		Color creamColor = (row == 245) ? new Color(255, 255, 192) : new Color(255, 215, 137);
+		b.Draw(Game1.staminaRect, new Rectangle((int)innerTopLeft.X, (int)innerTopLeft.Y, (int)innerSize.X, (int)innerSize.Y), creamColor * (tint.A / 255f));
+		// 3. The tractor (the Mods menu's own vehicle) at the bottom of the sign. At rest the sprite gets
+		// two Vita screen pixels per art pixel (8/3 UI pixels at the 0.75 UI zoom), so it stays crisp.
+		Texture2D tractor = VitaTractorRenderer.IconTexture;
+		if (tractor != null)
+		{
+			Rectangle frame = VitaTractorRenderer.GetFrameSource(1, 0);
+			Rectangle source = new Rectangle(frame.X, frame.Y + 9, 32, 23);
+			float tractorScale = scale * Math.Min(1f, 8f / 3f / button.baseScale);
+			b.Draw(tractor, center + new Vector2(0f, 18f * scale), source, tint, 0f, new Vector2(16f, 23f), tractorScale, SpriteEffects.None, 1f);
+		}
+		// 4. Localized label (Mods / Modlar / 模组) above the tractor. SpriteText pushes text that would leave the screen
+		// back onto it, so while the buttons slide away (Load, Co-op) the label would stay in the corner: skip it there.
+		Rectangle textBounds = new Rectangle((int)(center.X - 28f * scale), (int)(center.Y - 19f * scale), (int)(56f * scale), (int)(16f * scale));
+		if (textBounds.Right > Game1.uiViewport.Width)
+			return;
+		string label = VitaModsText.Button;
+		Color ink = (row == 245) ? new Color(239, 112, 105) : new Color(211, 82, 80);
+		ink = new Color(ink.R * tint.R / 255, ink.G * tint.G / 255, ink.B * tint.B / 255, tint.A);
+		VitaUiText.DrawTitleLabel(b, label, textBounds, ink);
+	}
