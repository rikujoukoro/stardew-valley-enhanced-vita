+	/// <summary>
+	/// The farm name, money and date lines, centred where vanilla puts them. With the extra ring column (x+328..392) they
+	/// would run over the slots: then they are centred further right and shrunk to fit between that column and the edge.
+	/// </summary>
+	private void VitaDrawStat(SpriteBatch b, string text, float y, Color color)
+	{
+		float width = Game1.dialogueFont.MeasureString(text).X;
+		float center = xPositionOnScreen + 32f + 512f + 32f;
+		float scale = 1f;
+		if (VitaExtraRings.Enabled)
+		{
+			float left = xPositionOnScreen + 48 + 280 + 64 + 16;
+			float right = trashCan.bounds.X - 8;
+			center = (left + right) / 2f;
+			scale = Math.Min(1f, (right - left) / Math.Max(1f, width));
+		}
+		Utility.drawTextWithShadow(b, text, Game1.dialogueFont, new Vector2(center - width * scale / 2f, y + (1f - scale) * Game1.dialogueFont.LineSpacing / 2f), color, scale);
+	}
+
