+	/// <summary>Port: on the Vita, how to build each page not built yet (null once built); see <see cref="VitaAddPage" />.</summary>
+	private readonly List<Func<int, int, int, int, IClickableMenu>> _vitaPageFactories = new List<Func<int, int, int, int, IClickableMenu>>();
+
+	private int _vitaPageX;
+
+	private int _vitaPageY;
+
+	private int _vitaPageWidth;
+
+	private int _vitaPageHeight;
+
+	/// <summary>Port: adds a page. Elsewhere it is built here as before; on the Vita only when its tab is first shown (<see cref="VitaEnsurePage" />), at the menu's opening size: building all ten when Start was pressed (every collection item, every villager, every recipe) took ~140 ms on the Vita, a visible hitch each time. The game doesn't run while the menu is open, so a page built later shows the same state. Pages are only reached through the current tab, which only <see cref="changeTab" /> moves.</summary>
+	private void VitaAddPage(Func<int, int, int, int, IClickableMenu> create)
+	{
+		if (_vitaPageFactories.Count == 0)
+		{
+			_vitaPageX = xPositionOnScreen;
+			_vitaPageY = yPositionOnScreen;
+			_vitaPageWidth = width;
+			_vitaPageHeight = height;
+		}
+		if (VitaPlatform.IsVita)
+		{
+			pages.Add(null);
+			_vitaPageFactories.Add(create);
+		}
+		else
+		{
+			pages.Add(create(_vitaPageX, _vitaPageY, _vitaPageWidth, _vitaPageHeight));
+			_vitaPageFactories.Add(null);
+		}
+	}
+
+	/// <summary>Port: builds the page of <paramref name="tab" /> if <see cref="VitaAddPage" /> left it for later.</summary>
+	private void VitaEnsurePage(int tab)
+	{
+		if (tab >= 0 && tab < pages.Count && pages[tab] == null && tab < _vitaPageFactories.Count && _vitaPageFactories[tab] != null)
+		{
+			pages[tab] = _vitaPageFactories[tab](_vitaPageX, _vitaPageY, _vitaPageWidth, _vitaPageHeight);
+			_vitaPageFactories[tab] = null;
+		}
+	}
+
 	public void AddTabsToClickableComponents(IClickableMenu menu)
 	{
 		menu.allClickableComponents.AddRange(tabs);
