+	/// <summary>Port: what the collection grid needs of an object, without the parsed names and descriptions (ParsedItemData ran TokenParser over ~1,900 strings and loaded every object's texture on each open: 150-246 ms).</summary>
+	private sealed class VitaEntry
+	{
+		public string ItemId;
+
+		public string QualifiedItemId;
+
+		public string ObjectType;
+
+		public int Category;
+
+		public string InternalName;
+
+		public string TextureName;
+
+		public int SpriteIndex;
+
+		public bool ExcludeFishing;
+	}
+
+	private static List<VitaEntry> _vitaEntries;
+
+	private static object _vitaEntriesSource;
+
+	/// <summary>Port: the sorted, laid-out entry list, built once per object data (the data changes with the language).</summary>
+	private static List<VitaEntry> VitaGetEntries()
+	{
+		if (_vitaEntries != null && _vitaEntriesSource == Game1.objectData)
+		{
+			return new List<VitaEntry>(_vitaEntries);
+		}
+		List<VitaEntry> all = new List<VitaEntry>(Game1.objectData.Count);
+		foreach (KeyValuePair<string, ObjectData> pair in Game1.objectData)
+		{
+			ObjectData raw = pair.Value;
+			int category = raw.Category;
+			if (category == 0 && raw.Type == "Ring")
+			{
+				category = -96;
+			}
+			all.Add(new VitaEntry
+			{
+				ItemId = pair.Key,
+				QualifiedItemId = "(O)" + pair.Key,
+				ObjectType = raw.Type,
+				Category = category,
+				InternalName = raw.Name,
+				TextureName = raw.Texture ?? "Maps\\springobjects",
+				SpriteIndex = raw.SpriteIndex,
+				ExcludeFishing = raw.ExcludeFromFishingCollection
+			});
+		}
+		List<VitaEntry> dataEntries = new List<VitaEntry>(from entry in all
+			orderby entry.TextureName, entry.SpriteIndex
+			select entry);
+		List<VitaEntry> wineAndFriends = new List<VitaEntry>();
+		for (int i = dataEntries.Count - 1; i >= 0; i--)
+		{
+			string s = dataEntries[i].InternalName;
+			if (s.Equals("Wine") || s.Equals("Pickles") || s.Equals("Jelly") || s.Equals("Juice"))
+			{
+				wineAndFriends.Add(dataEntries[i]);
+				dataEntries.RemoveAt(i);
+			}
+			if (wineAndFriends.Count == 4)
+			{
+				break;
+			}
+		}
+		wineAndFriends.Sort((VitaEntry a, VitaEntry b) => a.InternalName.CompareTo(b.InternalName));
+		dataEntries.Insert(278, wineAndFriends[2]);
+		dataEntries.Insert(279, wineAndFriends[0]);
+		dataEntries.Insert(283, wineAndFriends[3]);
+		dataEntries.Insert(284, wineAndFriends[1]);
+		_vitaEntries = dataEntries;
+		_vitaEntriesSource = Game1.objectData;
+		return new List<VitaEntry>(dataEntries);
+	}
