+	/// <summary>Port: parses the icons of the page being drawn once (see vitaDrawList). Same rules as the PC draw loop.</summary>
+	private void VitaBuildDrawCache(List<ClickableTextureComponent> list)
+	{
+		int count = list.Count;
+		if (vitaDrawColor.Length < count)
+		{
+			int size = Math.Max(128, count);
+			vitaDrawColor = new bool[size];
+			vitaDrawFaded = new bool[size];
+			vitaDrawSparkle = new int[size];
+			vitaDrawGrade = new int[size];
+		}
+		for (int i = 0; i < count; i++)
+		{
+			ClickableTextureComponent c = list[i];
+			string[] nameParts = ArgUtility.SplitBySpace(c.name);
+			bool drawColor = Convert.ToBoolean(nameParts[1]);
+			vitaDrawColor[i] = drawColor;
+			vitaDrawFaded[i] = (currentTab == 4 && Convert.ToBoolean(nameParts[2])) || (currentTab == 5 && !drawColor && c.hoverText != "???");
+			vitaDrawSparkle[i] = -1;
+			vitaDrawGrade[i] = -1;
+			if (currentTab == 5)
+			{
+				if (drawColor)
+				{
+					vitaDrawSparkle[i] = Utility.CreateRandom(Convert.ToInt32(nameParts[0])).Next(12);
+				}
+				if (int.TryParse(nameParts[0], out var achievementId) && VitaTrophies.TryGetGrade(achievementId, out var grade))
+				{
+					vitaDrawGrade[i] = (int)grade;
+				}
+			}
+		}
+		vitaDrawList = list;
+	}
+
+	/// <summary>Port: the icon loop of draw for the Vita, from the page cache.</summary>
+	private void VitaDrawIcons(SpriteBatch b)
+	{
+		List<ClickableTextureComponent> list = collections[currentTab][currentPage];
+		if (vitaDrawList != list)
+		{
+			VitaBuildDrawCache(list);
+		}
+		for (int i = 0; i < list.Count; i++)
+		{
+			ClickableTextureComponent c = list[i];
+			bool drawColor = vitaDrawColor[i];
+			Color c2;
+			if (vitaDrawFaded[i])
+			{
+				c2 = Color.DimGray * 0.4f;
+			}
+			else
+			{
+				c2 = (drawColor ? Color.White : (Color.Black * 0.2f));
+			}
+			c.draw(b, c2, 0.86f);
+			if (vitaDrawSparkle[i] >= 0)
+			{
+				int startPos = vitaDrawSparkle[i];
+				b.Draw(Game1.mouseCursors, new Vector2(c.bounds.X + 16 + 16, c.bounds.Y + 20 + 16), new Rectangle(256 + startPos % 6 * 64 / 2, 128 + startPos / 6 * 64 / 2, 32, 32), Color.White, 0f, new Vector2(16f, 16f), c.scale, SpriteEffects.None, 0.88f);
+			}
+			if (vitaDrawGrade[i] >= 0)
+			{
+				b.Draw(VitaTrophies.Icons, new Vector2(c.bounds.Right - 28, c.bounds.Bottom - 30), VitaTrophies.IconSource((VitaTrophies.Grade)vitaDrawGrade[i]), Color.White * (drawColor ? 1f : 0.45f), 0f, Vector2.Zero, 2f, SpriteEffects.None, 0.89f);
+			}
+		}
+	}
