+	/// <summary>Buttons held when the Vita menu opened must be released before they act (R+SELECT opens it).</summary>
+	private bool _vitaConfirmWasDown = true;
+
+	private bool _vitaCancelWasDown = true;
+
+	/// <summary>
+	/// Port: the Vita opens this with R+SELECT, not by holding the right stick, so the vanilla
+	/// "stick released = confirm" rule closed it 100 ms later with nothing chosen. Here it stays open:
+	/// either stick or the D-pad picks, Cross confirms, Circle closes. Returns true once the menu closed.
+	/// </summary>
+	private bool VitaUpdatePad()
+	{
+		GamePadState pad = Game1.input.GetGamePadState();
+		_mouseStartPosition = Game1.getMousePosition(ui_scale: false);
+		Vector2 offset = pad.ThumbSticks.Right;
+		if (Math.Abs(offset.X) <= 0.5f && Math.Abs(offset.Y) <= 0.5f)
+		{
+			offset = pad.ThumbSticks.Left;
+		}
+		if (Math.Abs(offset.X) <= 0.5f && Math.Abs(offset.Y) <= 0.5f)
+		{
+			offset = Vector2.Zero;
+			if (pad.IsButtonDown(Buttons.DPadLeft)) offset.X -= 1f;
+			if (pad.IsButtonDown(Buttons.DPadRight)) offset.X += 1f;
+			if (pad.IsButtonDown(Buttons.DPadUp)) offset.Y += 1f;
+			if (pad.IsButtonDown(Buttons.DPadDown)) offset.Y -= 1f;
+		}
+		if (offset != Vector2.Zero)
+		{
+			_hasSelectedEmote = true;
+			offset.Y *= -1f;
+			offset.Normalize();
+			float highest_dot = -1f;
+			for (int i = 0; i < _emoteButtons.Count; i++)
+			{
+				Vector2 button = new Vector2((float)_emoteButtons[i].bounds.Center.X - ((float)xPositionOnScreen + (float)width / 2f), (float)_emoteButtons[i].bounds.Center.Y - ((float)yPositionOnScreen + (float)height / 2f));
+				float dot = Vector2.Dot(offset, button);
+				if (dot > highest_dot)
+				{
+					highest_dot = dot;
+					_selectedEmote = emotes[i];
+					_selectedIndex = i;
+				}
+			}
+		}
+		bool confirmDown = pad.IsButtonDown(Buttons.A);
+		bool cancelDown = pad.IsButtonDown(Buttons.B);
+		bool confirm = confirmDown && !_vitaConfirmWasDown;
+		bool cancel = cancelDown && !_vitaCancelWasDown;
+		_vitaConfirmWasDown = confirmDown;
+		_vitaCancelWasDown = cancelDown;
+		if (cancel)
+		{
+			exitThisMenuNoSound();
+			return true;
+		}
+		if (confirm && _selectedEmote != null)
+		{
+			ConfirmSelection();
+			return true;
+		}
+		return false;
+	}
+
 	public void ConfirmSelection()
