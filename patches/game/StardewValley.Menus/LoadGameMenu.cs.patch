+	/// <summary>Port: the menu's left edge on the Vita. The scroll arrows and bar sit 16 px right of the frame and are 44 px wide, so the whole group (frame + 60 px) is centered in the UI viewport (1280 px wide at the Vita's UI scale) with the same margin on both sides; the PC centering put the arrows 2 px past the right edge.</summary>
+	private static int VitaMenuX(int menuWidth)
+	{
+		return Math.Max(0, (Game1.uiViewport.Width - (menuWidth + 16 + 44)) / 2);
+	}
+
+	/// <summary>Port: the menu's top edge on the Vita. The frame is drawn 32 px taller than the menu's height, so that is what gets centered (the PC constructor left the frame 1 px past the bottom of the 726 px UI viewport).</summary>
