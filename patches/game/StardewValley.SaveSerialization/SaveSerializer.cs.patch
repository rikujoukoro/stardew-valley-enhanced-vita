+	/// <summary>Port: reads a Vector2, int, long, bool or (non-null) string the way its XmlSerializer wrote it; false, with nothing read, for anything else.</summary>
+	/// <remarks>SerializableDictionary reads every key and value through an XmlSerializer of its own, and these types have no pregenerated one: Mono builds them at run time and interprets them, per key - thousands of Vector2 tile keys in a save.</remarks>
+	public static bool TryReadPrimitive(XmlReader reader, Type type, out object value)
+	{
+		value = null;
+		if (type == typeof(Vector2))
+		{
+			if (!reader.IsStartElement("Vector2") || reader.IsEmptyElement)
+			{
+				return false;
+			}
+			float x = 0f;
+			float y = 0f;
+			reader.ReadStartElement();
+			reader.MoveToContent();
+			while (reader.NodeType == XmlNodeType.Element)
+			{
+				switch (reader.LocalName)
+				{
+				case "X":
+					x = reader.ReadElementContentAsFloat();
+					break;
+				case "Y":
+					y = reader.ReadElementContentAsFloat();
+					break;
+				default:
+					reader.Skip();
+					break;
+				}
+				reader.MoveToContent();
+			}
+			reader.ReadEndElement();
+			value = new Vector2(x, y);
+			return true;
+		}
+		if (type == typeof(int))
+		{
+			if (!reader.IsStartElement("int"))
+			{
+				return false;
+			}
+			value = XmlConvert.ToInt32(reader.ReadElementContentAsString());
+			return true;
+		}
+		if (type == typeof(long))
+		{
+			if (!reader.IsStartElement("long"))
+			{
+				return false;
+			}
+			value = XmlConvert.ToInt64(reader.ReadElementContentAsString());
+			return true;
+		}
+		if (type == typeof(bool))
+		{
+			if (!reader.IsStartElement("boolean"))
+			{
+				return false;
+			}
+			value = XmlConvert.ToBoolean(reader.ReadElementContentAsString());
+			return true;
+		}
+		if (type == typeof(string))
+		{
+			// xsi:nil (a null string) is left to the serializer.
+			if (!reader.IsStartElement("string") || reader.GetAttribute("nil", "http://www.w3.org/2001/XMLSchema-instance") != null)
+			{
+				return false;
+			}
+			value = reader.ReadElementContentAsString();
+			return true;
+		}
+		return false;
+	}
