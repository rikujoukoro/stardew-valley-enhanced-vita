+	private static Dictionary<string, Dictionary<int, string>> GetParsedChairTiles(Dictionary<string, string> chair_tile_data)
+	{
+		if (!object.ReferenceEquals(chair_tile_data, _cachedChairDataSource) || _cachedChairTilesBySheet == null)
+		{
+			_cachedChairDataSource = chair_tile_data;
+			_cachedChairTilesBySheet = new Dictionary<string, Dictionary<int, string>>(StringComparer.Ordinal);
+			foreach (KeyValuePair<string, string> kvp in chair_tile_data)
+			{
+				int s1 = kvp.Key.IndexOf('/');
+				int s2 = (s1 >= 0) ? kvp.Key.IndexOf('/', s1 + 1) : (-1);
+				if (s1 > 0 && s2 > s1 + 1 && int.TryParse(kvp.Key.Substring(s1 + 1, s2 - s1 - 1), out int tx) && int.TryParse(kvp.Key.Substring(s2 + 1), out int ty))
+				{
+					string sheetName = kvp.Key.Substring(0, s1);
+					if (!_cachedChairTilesBySheet.TryGetValue(sheetName, out var sheetDict))
+					{
+						sheetDict = new Dictionary<int, string>();
+						_cachedChairTilesBySheet[sheetName] = sheetDict;
+					}
+					sheetDict[(tx << 16) | (ty & 0xFFFF)] = kvp.Value;
+				}
+			}
+		}
+		return _cachedChairTilesBySheet;
+	}
