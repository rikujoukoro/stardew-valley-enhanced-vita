+	/// <summary>Port: whether <see cref="M:StardewValley.Object.updateWhenCurrentLocation(Microsoft.Xna.Framework.GameTime)" /> does anything for this object's id, cached per id string.</summary>
+	private bool IdHasFrameUpdate()
+	{
+		string qualifiedItemId = QualifiedItemId;
+		if ((object)qualifiedItemId != _idHasFrameUpdateFor)
+		{
+			_idHasFrameUpdate = qualifiedItemId == "(O)590" || qualifiedItemId == "(O)SeedSpot" || qualifiedItemId == "(BC)56" || IsTextSign();
+			_idHasFrameUpdateFor = qualifiedItemId;
+		}
+		return _idHasFrameUpdate;
+	}
+
+	/// <summary>Port: whether <see cref="updateWhenCurrentLocation" /> would change anything for this object now (GameLocation lists only these each tick). Types with their own update count as always busy unless they say otherwise (<see cref="Fence" />).</summary>
+	internal virtual bool NeedsFrameUpdate
+	{
+		get
+		{
+			if (OverridesFrameUpdate(GetType()))
+			{
+				return true;
+			}
+			return BaseNeedsFrameUpdate;
+		}
+	}
+
+	/// <summary>Port: whether this class's own <see cref="updateWhenCurrentLocation" /> has anything to do.</summary>
+	private bool BaseNeedsFrameUpdate
+	{
+		get
+		{
+			if (!_hasHeldObject && !_hasLightSource && _machineAnimation == null && shakeTimer <= 0 && !readyForHarvest.Value)
+			{
+				return IdHasFrameUpdate();
+			}
+			return true;
+		}
+	}
+
+	private static readonly Dictionary<Type, bool> _overridesFrameUpdate = new Dictionary<Type, bool>();
+
+	/// <summary>Port: whether a type replaces <see cref="updateWhenCurrentLocation" />, cached per type.</summary>
+	private static bool OverridesFrameUpdate(Type type)
+	{
+		if (type == typeof(Object))
+		{
+			return false;
+		}
+		if (!_overridesFrameUpdate.TryGetValue(type, out bool overrides))
+		{
+			overrides = type.GetMethod("updateWhenCurrentLocation", new Type[1] { typeof(GameTime) })?.DeclaringType != typeof(Object);
+			_overridesFrameUpdate[type] = overrides;
+		}
+		return overrides;
+	}
