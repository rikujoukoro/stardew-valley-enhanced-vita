+	// Port: TimeSpan.Milliseconds is a 64-bit divide + remainder (__emul_ldiv/lrem on the Vita's ARM, no hardware divide) and
+	// every NPC/animal/pet read it each tick. The step is the same every tick, so the result is kept per Ticks value.
+	private static long _elapsedMsTicks = -1L;
+
+	private static int _elapsedMs;
+
+	private static float _elapsedTotalMsF;
+
+	private static float _elapsedTotalSecF;
+
+	public static int ElapsedMs(GameTime time)
+	{
+		long ticks = time.ElapsedGameTime.Ticks;
+		if (ticks != _elapsedMsTicks)
+		{
+			_elapsedMs = time.ElapsedGameTime.Milliseconds;
+			_elapsedTotalMsF = (float)time.ElapsedGameTime.TotalMilliseconds;
+			_elapsedTotalSecF = (float)time.ElapsedGameTime.TotalSeconds;
+			_elapsedMsTicks = ticks;
+		}
+		return _elapsedMs;
+	}
+
+	// Port: (float)ElapsedGameTime.TotalMilliseconds, cached per step like ElapsedMs (a long->double convert plus a double divide each call).
+	public static float ElapsedTotalMsF(GameTime time)
+	{
+		ElapsedMs(time);
+		return _elapsedTotalMsF;
+	}
+
+	// Port: (float)ElapsedGameTime.TotalSeconds, cached per step.
+	public static float ElapsedTotalSecF(GameTime time)
+	{
+		ElapsedMs(time);
+		return _elapsedTotalSecF;
+	}
