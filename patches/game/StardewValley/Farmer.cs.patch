+	public Object TryFindStackForDebris(string rawItemId, int stack, int quality, ParsedItemData cachedData)
+	{
+		if (!IsLocalPlayer || rawItemId == null || stack <= 0)
+		{
+			return null;
+		}
+		ParsedItemData data = cachedData ?? ItemRegistry.GetDataOrErrorItem(rawItemId);
+		if (data == null || !data.HasTypeObject())
+		{
+			return null;
+		}
+		string qid = data.QualifiedItemId;
+		switch (qid)
+		{
+		case "(O)73":
+		case "(O)102":
+		case "(O)858":
+		case "(O)930":
+		case "(O)GoldCoin":
+		case "(O)535":
+		case "(O)74":
+		case "(O)72":
+			return null;
+		}
+		if (data.Category == -2 || data.ObjectType == "Minerals" || data.ObjectType == "Arch")
+		{
+			return null;
+		}
+		int max = Math.Min(maxItems.Value, Items.Count);
+		int hint = _lastMergedSlotIndex;
+		if ((uint)hint < (uint)max)
+		{
+			Item hinted = Items[hint];
+			if (hinted != null && hinted.GetType() == typeof(Object) && hinted.QualifiedItemId == qid && hinted.quality.Value == quality && hinted.Stack + stack <= hinted.maximumStackSize() && ((Object)hinted).orderData.Value == null && hinted.Name == data.InternalName)
+			{
+				return (Object)hinted;
+			}
+		}
+		for (int i = 0; i < max; i++)
+		{
+			Item slot = Items[i];
+			if (slot != null && slot.GetType() == typeof(Object) && slot.QualifiedItemId == qid && slot.quality.Value == quality && slot.Stack + stack <= slot.maximumStackSize() && ((Object)slot).orderData.Value == null && slot.Name == data.InternalName)
+			{
+				_lastMergedSlotIndex = i;
+				return (Object)slot;
+			}
+		}
+		return null;
+	}
