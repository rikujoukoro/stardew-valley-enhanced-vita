+	/// <summary>Port: L + R + right switches the camera between Far and Close in play, L + R + left the frame rate cap
+	/// (30, 60, Auto); each shows what it switched to for a moment.</summary>
+	/// <remarks>Read here, every tick of play, from the pad state as the game sees it (L and R arrive as the triggers in play,
+	/// InputState.MapVitaButtons): inside UpdateControlInput it sat behind branches that skip it on some ticks.</remarks>
+	private static void VitaCameraShortcut()
+	{
+		if (!VitaPlatform.IsVita)
+		{
+			return;
+		}
+		VitaPassableCrops.Load();
+		GamePadState pad = input.GetGamePadState();
+		bool shoulders = (pad.IsButtonDown(Buttons.LeftShoulder) || pad.Triggers.Left > 0.5f) && (pad.IsButtonDown(Buttons.RightShoulder) || pad.Triggers.Right > 0.5f);
+		// The four in any order: each switches once when the last of its buttons goes down.
+		bool cameraDown = shoulders && pad.IsButtonDown(Buttons.DPadRight);
+		bool fpsDown = shoulders && pad.IsButtonDown(Buttons.DPadLeft);
+		bool tractorDown = shoulders && pad.IsButtonDown(Buttons.DPadDown);
+		bool chestDown = shoulders && pad.IsButtonDown(Buttons.DPadUp);
+		bool cameraPressed = cameraDown && !_vitaCameraComboWasDown;
+		bool fpsPressed = fpsDown && !_vitaFpsComboWasDown;
+		bool tractorPressed = tractorDown && !_vitaTractorComboWasDown;
+		bool chestPressed = chestDown && !_vitaChestComboWasDown;
+		_vitaCameraComboWasDown = cameraDown;
+		_vitaFpsComboWasDown = fpsDown;
+		_vitaTractorComboWasDown = tractorDown;
+		_vitaChestComboWasDown = chestDown;
+		// In play L/R alone switch the item (triggers, InputState.MapVitaButtons). Pressing both for a shortcut would switch it
+		// by the first of them: remember the slot from the first press and hold it there until both are released.
+		bool leftDown = pad.IsButtonDown(Buttons.LeftShoulder) || pad.Triggers.Left > 0.5f;
+		bool rightDown = pad.IsButtonDown(Buttons.RightShoulder) || pad.Triggers.Right > 0.5f;
+		if (!leftDown && !rightDown)
+		{
+			_vitaShoulderToolIndex = -1;
+			_vitaShoulderCombo = false;
+			if (player != null && activeClickableMenu == null)
+			{
+				_vitaIdleToolIndex = player.CurrentToolIndex;
+			}
+		}
+		else if (player != null && activeClickableMenu == null)
+		{
+			if (_vitaShoulderToolIndex < 0)
+			{
+				// UpdateControlInput already switched the item for this press: take the slot from before it.
+				_vitaShoulderToolIndex = (_vitaIdleToolIndex >= 0) ? _vitaIdleToolIndex : player.CurrentToolIndex;
+			}
+			_vitaShoulderCombo |= shoulders;
+			if (_vitaShoulderCombo && player.CurrentToolIndex != _vitaShoulderToolIndex && _vitaShoulderToolIndex < player.Items.Count)
+			{
+				player.CurrentToolIndex = _vitaShoulderToolIndex;
+			}
+		}
+		if (chestPressed && VitaChestMod.Enabled)
+		{
+			// Only into the chest being looked at (its menu open); never from the field.
+			VitaChestMod.StackIntoOpenChest(player);
+			return;
+		}
+		if (activeClickableMenu != null)
+		{
+			return;
+		}
+		if (tractorPressed)
+		{
+			VitaTractorMod.ToggleTractorHotkey(player);
+		}
+		else if (cameraPressed)
+		{
+			Options.VitaSetCameraZoom((VitaPlatform.CameraZoom == 0) ? 1 : 0);
+			playSound("shwip");
+			VitaShowShortcutMessage((VitaPlatform.IsTr ? "Kamera: " : "Camera: ") + VitaPlatform.CameraZoomLabels[VitaPlatform.CameraZoom]);
+			VitaPlatform.Trace("camera shortcut: L + R + right");
+		}
+		else if (fpsPressed)
+		{
+			VitaPlatform.FpsLimitIndex = (VitaPlatform.FpsLimitIndex + 1) % VitaPlatform.FpsLimitLabels.Count;
+			playSound("shwip");
+			string label = (VitaPlatform.FpsLimit == 0) ? (VitaPlatform.IsTr ? "Otomatik" : "Auto") : VitaPlatform.FpsLimit.ToString();
+			VitaShowShortcutMessage((VitaPlatform.IsTr ? "FPS sınırı: " : "FPS limit: ") + label);
+			VitaPlatform.Trace("fps shortcut: L + R + left, cap " + label);
+		}
+	}
