+			while (fill < blockLen)
+			{
+				if (rowPos == row.Length)
+				{
+					// Next row: convert straight from the Color[] (R, G, B bytes).
+					int src = nextY * width;
+					int dst = 1;
+					row[0] = 0;
+					for (int x = 0; x < width; x++)
+					{
+						Microsoft.Xna.Framework.Color px = colors[src + x];
