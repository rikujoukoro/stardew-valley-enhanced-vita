+			int blockLen = raw - written;
+			if (blockLen > 65535)
+			{
+				blockLen = 65535;
+			}
+			blk[0] = (byte)((written + blockLen >= raw) ? 1 : 0);
+			blk[1] = (byte)blockLen;
+			blk[2] = (byte)(blockLen >> 8);
+			blk[3] = (byte)~blockLen;
+			blk[4] = (byte)(~blockLen >> 8);
