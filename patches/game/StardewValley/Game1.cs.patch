+		_vitaBackCacheViewRows = rows;
+		_vitaBackCacheMargin = margin;
+		_vitaBackCacheScale = scale;
+		_vitaBackCacheColor = color;
+		_vitaBackCacheEdits = xTile.Layers.Layer.VitaTileEdits;
