+		uint adlerA = 1;
+		uint adlerB = 0;
+		// One row of the raw stream: filter byte 0, then the RGB pixels.
+		byte[] row = new byte[rowBytes + 1];
+		int rowPos = row.Length;
+		int nextY = 0;
+		// One stored block: 5 header bytes, then up to 65535 data bytes.
+		byte[] blk = new byte[5 + 65535];
+		int written = 0;
+		while (written < raw)
