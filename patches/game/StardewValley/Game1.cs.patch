+	/// <summary>Port: before a language change reloads the fonts and sheets, lets the previous language's copies go.</summary>
+	/// <remarks>
+	/// Each language loads its own copies under their own names (LooseSprites/Cursors.tr-TR is 16 MB), and the caches kept
+	/// them all: language changes on the title screen filled vitaGL's GPU memory, and one after a long session ran out of
+	/// memory reading Cursors. The other languages' copies leave the caches first (LocalizedContentManager.VitaForgetOtherLanguages,
+	/// not disposed: a menu may still draw with one), Game1's own references to what is about to be reloaded are dropped, and a
+	/// full collection frees what nothing else uses before the new copies are read; their finalizers queue the GPU frees.
+	/// </remarks>
+	private void VitaReleaseLanguageAssets()
+	{
+		_vitaLanguageFreeKB = VitaPlatform.GraphicsFreeKB();
+		SpriteText.VitaReleaseFontData();
+		objectSpriteSheet = null;
+		objectSpriteSheet_2 = null;
+		bobbersTexture = null;
+		dialogueFont = null;
+		smallFont = null;
+		tinyFont = null;
+		mouseCursors = null;
+		mouseCursors2 = null;
+		mouseCursors_1_6 = null;
+		giftboxTexture = null;
+		controllerMaps = null;
+		_vitaLanguageDropped = LocalizedContentManager.VitaForgetOtherLanguages(dispose: true);
+		GC.Collect();
+		GC.WaitForPendingFinalizers();
+		GC.Collect();
 	}
 
