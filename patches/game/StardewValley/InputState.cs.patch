+	/// <summary>Port: whether a held L or R reads as released this poll: in menus, from 0.4 s held on, one poll in each 0.15 s, so the press repeats (the poll after it reads as pressed again).</summary>
+	private static bool VitaHeldRepeatGap(ref long heldSince, ref long gaps, bool inMenu)
+	{
+		long now = System.Diagnostics.Stopwatch.GetTimestamp();
+		if (heldSince == 0)
+		{
+			heldSince = now;
+			gaps = 0;
+			return false;
+		}
+		if (!inMenu)
+		{
+			return false;
+		}
+		long frequency = System.Diagnostics.Stopwatch.Frequency;
+		long held = now - heldSince - frequency * 4 / 10;
+		if (held < 0)
+		{
+			return false;
+		}
+		long due = held / (frequency * 15 / 100) + 1;
+		if (due > gaps)
+		{
+			gaps = due;
+			return true;
+		}
+		return false;
+	}
