+	/// <summary>Port: the Vita's frame rate cap (<see cref="P:StardewValley.VitaPlatform.FpsLimit" />). Updates keep their 60 a second.</summary>
+	/// <remarks>
+	/// At 30 the display waits two refreshes per flip, so every frame is up for exactly 33.3 ms, and the fixed timestep runs
+	/// two updates per frame. Draws used to be skipped by the clock instead: the skips drifted against the vsync, some
+	/// frames stayed up 50 ms and others 16, and the cap measured 28 fps that looked worse than 60 with drops.
+	/// </remarks>
+	protected override bool BeginDraw()
