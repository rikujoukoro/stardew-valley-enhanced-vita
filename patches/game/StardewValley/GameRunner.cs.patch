+	/// <summary>Port: the automatic frame rate cap, as the official Vita release had it: 60 while one update and one draw fit in a 60 Hz frame, 30 as soon as they don't, back to 60 once they fit again with room to spare. A frame that would just miss 16.6 ms is shown on the vsync after next (a 33 ms hitch among 16 ms frames); a steady 30 looks smoother than 60 with such hitches.</summary>
+	/// <remarks>Looks every quarter second, so a busy spot switches within a few frames; after dropping to 30 it stays there at least a second, so it doesn't flicker between the two.</remarks>
+	private int VitaAutoFrameLimit()
+	{
+		long now = Stopwatch.GetTimestamp();
+		if (now >= _vitaAutoWindowEnd)
+		{
+			if (_vitaAutoUpdates > 0 && _vitaAutoDraws > 0)
+			{
+				double tickMs = 1000.0 / Stopwatch.Frequency;
+				double frameMs = _vitaAutoUpdateTicks * tickMs / _vitaAutoUpdates + _vitaAutoDrawTicks * tickMs / _vitaAutoDraws;
