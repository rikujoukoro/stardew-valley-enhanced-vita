 	public static Microsoft.Xna.Framework.Rectangle controllerMapSourceRect(Microsoft.Xna.Framework.Rectangle xboxSourceRect)
 	{
+		// Port: ControllerMaps.xnb holds four layouts stacked 288 px apart (Xbox, PlayStation, Switch, PlayStation-JP).
+		// The Vita shows the PlayStation set (Cross = confirm, Circle = cancel, Square = use tool, Triangle = crafting).
+		// Same texture that is already loaded, so this costs no extra memory.
+		if (VitaPlatform.IsVita)
+		{
+			xboxSourceRect.Y += 288;
+		}
 		return xboxSourceRect;
 	}
 
+	/// <summary>Port: START drawn over the PlayStation layout's OPTIONS button in the "Menu" box of the button tutorial
+	/// (ButtonTutorialMenu): the Vita's menu button is START.</summary>
+	/// <remarks>Written into the loaded texture once per load, 48 x 28 pixels. The box sits lower where its title takes more
+	/// room (measured from each language's ControllerMaps); other languages use the English position.</remarks>
+	public static void VitaPatchControllerMaps(Texture2D texture)
+	{
+		if (!VitaPlatform.IsVita || texture == null)
+		{
+			return;
+		}
+		int centerX = 633;
+		int centerY = 404; // PlayStation layout (Utility.controllerMapSourceRect: 288 down)
+		switch (LocalizedContentManager.CurrentLanguageCode)
+		{
+		case LocalizedContentManager.LanguageCode.ru:
+			centerY = 406;
+			break;
+		case LocalizedContentManager.LanguageCode.tr:
+			centerX = 632;
+			centerY = 412;
+			break;
+		}
+		// A START button in the icons' colors, one character per 2 x 2 texture pixels (the sheet's pixel size).
+		string[] art = new string[9]
+		{
+			"..ooooooooooooooooooo..",
+			".offfffffffffffffffffo.",
+			"oftttftttfftffttfftttfo",
+			"oftfffftfftftftftfftffo",
+			"oftttfftfftttfttffftffo",
+			"offftfftfftftftftfftffo",
+			"oftttfftfftftftftfftffo",
+			".offfffffffffffffffffo.",
+			"..ooooooooooooooooooo.."
+		};
+		const int width = 48;
+		const int height = 28;
+		Color[] pixels = new Color[width * height];
+		Color background = new Color(0, 12, 22);
+		for (int i = 0; i < pixels.Length; i++)
+		{
+			pixels[i] = background;
+		}
+		int left = (width - art[0].Length * 2) / 2;
+		int top = (height - art.Length * 2) / 2;
+		for (int row = 0; row < art.Length; row++)
+		{
+			for (int column = 0; column < art[row].Length; column++)
+			{
+				Color color;
+				switch (art[row][column])
+				{
+				case 'o':
+					color = new Color(22, 22, 22);
+					break;
+				case 'f':
+					color = new Color(81, 81, 81);
+					break;
+				case 't':
+					color = new Color(181, 181, 181);
+					break;
+				default:
+					continue;
+				}
+				for (int dy = 0; dy < 2; dy++)
+				{
+					for (int dx = 0; dx < 2; dx++)
+					{
+						pixels[(top + row * 2 + dy) * width + left + column * 2 + dx] = color;
+					}
+				}
+			}
+		}
+		try
+		{
+			texture.SetData(0, new Microsoft.Xna.Framework.Rectangle(centerX - width / 2, centerY - height / 2, width, height), pixels, 0, pixels.Length);
+		}
+		catch (Exception e)
+		{
+			VitaPlatform.Trace("controller map patch failed: " + e.Message);
+		}
+	}
+
