+	// Port: TimeSpan.Milliseconds is a 64-bit divide and modulo (slow on the Vita's ARM). The frame time is the same
+	// TimeSpan almost every call, so the last answer is reused. Game thread only.
+	private static long _elapsedMsTicks = -1L;
+
+	private static int _elapsedMsValue;
+
+	public static int ElapsedMs(TimeSpan span)
+	{
+		long ticks = span.Ticks;
+		if (ticks != _elapsedMsTicks)
+		{
+			_elapsedMsValue = span.Milliseconds;
+			_elapsedMsTicks = ticks;
+		}
+		return _elapsedMsValue;
+	}
