+	/// <summary>Port: the manifest's asset names, kept in the game folder (the working directory) after the first boot; parsing ContentHashes.json (~240 KB) took ~450 ms of every boot on the Vita.</summary>
+	private const string ManifestCacheFile = "content-manifest.txt";
+
+	/// <summary>Port: what the cache was made from - ContentHashes.json's size and time - so a changed manifest is parsed again.</summary>
+	private static string ManifestCacheStamp(string manifestPath)
+	{
+		FileInfo info = new FileInfo(manifestPath);
+		return info.Exists ? $"{info.Length}|{info.LastWriteTimeUtc.Ticks}" : null;
+	}
+
+	private static bool TryLoadManifestCache(string manifestPath)
+	{
+		try
+		{
+			string stamp = ManifestCacheStamp(manifestPath);
+			if (stamp == null || !File.Exists(ManifestCacheFile))
+			{
+				return false;
+			}
+			using StreamReader reader = new StreamReader(ManifestCacheFile);
+			if (reader.ReadLine() != stamp)
+			{
+				return false;
+			}
+			string name;
+			while ((name = reader.ReadLine()) != null)
+			{
+				if (name.Length > 0)
+				{
+					_manifest.Add(name);
+				}
+			}
+			return _manifest.Count > 0;
+		}
+		catch (Exception exception)
+		{
+			VitaPlatform.Trace("manifest cache unreadable: " + exception.Message);
+			_manifest.Clear();
+			return false;
+		}
+	}
+
+	private static void SaveManifestCache(string manifestPath)
+	{
+		try
+		{
+			string stamp = ManifestCacheStamp(manifestPath);
+			if (stamp == null)
+			{
+				return;
+			}
+			using StreamWriter writer = new StreamWriter(ManifestCacheFile + ".tmp");
+			writer.WriteLine(stamp);
+			foreach (string name in _manifest)
+			{
+				writer.WriteLine(name);
+			}
+			writer.Close();
+			File.Delete(ManifestCacheFile);
+			File.Move(ManifestCacheFile + ".tmp", ManifestCacheFile);
+		}
+		catch (Exception exception)
+		{
+			VitaPlatform.Trace("manifest cache not written: " + exception.Message);
+		}
+	}
+
