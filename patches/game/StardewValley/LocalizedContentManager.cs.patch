+	/// <summary>Port: on the Vita, drops the assets other languages loaded (their own Cursors, fonts, title buttons, non-Latin BmFont sheets, and superseded English base assets) from every manager's cache.</summary>
+	public static int VitaForgetOtherLanguages(bool dispose = true)
+	{
+		LanguageCode code = CurrentLanguageCode;
+		string current = "." + CurrentLanguageString;
+		string keepFontPrefix = code switch
+		{
+			LanguageCode.ja => "fonts/japanese",
+			LanguageCode.zh => "fonts/chinese",
+			LanguageCode.ru => "fonts/russian",
+			LanguageCode.th => "fonts/thai",
+			LanguageCode.ko => "fonts/korean",
+			_ => null
+		};
+		int dropped = 0;
+		lock (vitaManagers)
+		{
+			foreach (WeakReference w in vitaManagers)
+			{
+				if (w.Target is LocalizedContentManager manager)
+				{
+					manager.fastAssets.Clear();
+					dropped += manager.VitaForgetAssets(delegate(string key)
+					{
+						if (key.StartsWith("fonts/japanese", StringComparison.OrdinalIgnoreCase) ||
+							key.StartsWith("fonts/chinese", StringComparison.OrdinalIgnoreCase) ||
+							key.StartsWith("fonts/russian", StringComparison.OrdinalIgnoreCase) ||
+							key.StartsWith("fonts/thai", StringComparison.OrdinalIgnoreCase) ||
+							key.StartsWith("fonts/korean", StringComparison.OrdinalIgnoreCase))
+						{
+							return keepFontPrefix == null || !key.StartsWith(keepFontPrefix, StringComparison.OrdinalIgnoreCase);
+						}
+						int dot = key.LastIndexOf('.');
+						if (dot > 0 && key.Length - dot == 6 && key[dot + 3] == '-' && key.LastIndexOf('/') < dot)
+						{
+							return !key.EndsWith(current, StringComparison.OrdinalIgnoreCase);
+						}
+						if (code != LanguageCode.en && code != LanguageCode.mod && manager.DoesAssetExist<object>(key + current))
+						{
+							return true;
+						}
+						return false;
+					}, dispose);
+					manager.loadedAssetNames.RemoveWhere((string name) => !manager.VitaIsKeyLoaded(name.Replace('\\', '/')));
+				}
+			}
+		}
+		return dropped;
 	}
 
