+	/// <summary>Read the default_options file, or null if it's missing or unreadable.</summary>
+	private Options ReadDefaultOptionsFile()
+	{
+		try
+		{
+			using FileStream stream = File.Open(GetFilePathForDefaultOptions(), FileMode.Open);
+			return defaultSettingsSerializer.DeserializeFast(stream) as Options;
+		}
+		catch (Exception)
+		{
+			return null;
+		}
+	}
+
+	/// <summary>Use the volume levels from default_options instead of the ones stored in the save.</summary>
+	/// <remarks>
+	/// Port: the original keeps volume in each save, written only when the day is saved, so a volume
+	/// changed and then quit without sleeping came back as the save's old level on the next load (and
+	/// loading then copied that level into default_options too). Volume is treated as a device
+	/// setting here: the last level set anywhere is kept for every save.
+	/// </remarks>
+	public void ApplyGlobalAudioLevels()
+	{
+		if (!Game1.game1.IsMainInstance)
+		{
+			return;
+		}
+		Options global = ReadDefaultOptionsFile();
+		if (global == null)
+		{
+			return;
+		}
+		musicVolumeLevel = global.musicVolumeLevel;
+		soundVolumeLevel = global.soundVolumeLevel;
+		ambientVolumeLevel = global.ambientVolumeLevel;
+		footstepVolumeLevel = global.footstepVolumeLevel;
+	}
