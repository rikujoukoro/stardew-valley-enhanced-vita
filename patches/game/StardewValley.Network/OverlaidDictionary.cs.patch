+	/// <summary>Port: puts every object whose key is a whole tile inside the window (x0, y0, w, h) into <paramref name="grid" /> at (y - y0) * w + (x - x0). What TryGetValue would find for each tile of the window, in one pass over the dictionary (GameLocation.draw).</summary>
+	public void GatherInto(Object[] grid, int x0, int y0, int w, int h)
+	{
+		foreach (KeyValuePair<Vector2, Object> pair in compositeDict)
+		{
+			float keyX = pair.Key.X;
+			float keyY = pair.Key.Y;
+			int ix = (int)keyX;
+			int iy = (int)keyY;
+			if (ix >= x0 && ix < x0 + w && iy >= y0 && iy < y0 + h && (float)ix == keyX && (float)iy == keyY)
+			{
+				grid[(iy - y0) * w + (ix - x0)] = pair.Value;
+			}
+		}
+	}
+
+	/// <summary>Port: populates a flat map-wide tile index (y * width + x) from compositeDict when Version/Count changes.</summary>
+	public void PopulateTileArray(Object[] tiles, int width, int height)
+	{
+		foreach (KeyValuePair<Vector2, Object> pair in compositeDict)
+		{
+			float keyX = pair.Key.X;
+			float keyY = pair.Key.Y;
+			int ix = (int)keyX;
+			int iy = (int)keyY;
+			if (ix >= 0 && ix < width && iy >= 0 && iy < height && (float)ix == keyX && (float)iy == keyY)
+			{
+				tiles[iy * width + ix] = pair.Value;
+			}
+		}
+	}
+
