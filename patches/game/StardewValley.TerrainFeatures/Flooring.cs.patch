+	private FloorPathData _cachedData;
+
+	private string _cachedDataId;
+
+	private IDictionary<string, FloorPathData> _cachedDataSource;
+
 	public FloorPathData GetData()
 	{
-		if (!TryGetData(whichFloor.Value, out var data))
+		string id = whichFloor.Value;
+		IDictionary<string, FloorPathData> source = Game1.floorPathData;
