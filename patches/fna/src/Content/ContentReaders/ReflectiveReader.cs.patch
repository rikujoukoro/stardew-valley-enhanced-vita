+
+	/// <summary>Port: setter delegates for class-typed content objects (see ReflectiveReader.GetElementReader).</summary>
+	internal static class FastPropertySetter
+	{
+		internal static Action<object, object> TryCreate(PropertyInfo property)
+		{
+			try
+			{
+				MethodInfo set = property.GetSetMethod(true);
+				Type owner = property.DeclaringType;
+				if (set == null || set.IsStatic || owner == null || !owner.IsClass || owner.ContainsGenericParameters || property.PropertyType.IsByRef || property.PropertyType.ContainsGenericParameters)
+				{
+					return null;
+				}
+				MethodInfo create = typeof(Binder<,>).MakeGenericType(owner, property.PropertyType).GetMethod("Create", BindingFlags.Static | BindingFlags.NonPublic);
+				return (Action<object, object>) create.Invoke(null, new object[] { set });
+			}
+			catch (Exception)
+			{
+				return null; // the reflective setter stays the fallback
+			}
+		}
+
+		private static class Binder<TOwner, TValue> where TOwner : class
+		{
+			internal static Action<object, object> Create(MethodInfo set)
+			{
+				Action<TOwner, TValue> bound = (Action<TOwner, TValue>) Delegate.CreateDelegate(typeof(Action<TOwner, TValue>), set);
+				return (o, v) => bound((TOwner) o, (TValue) v);
+			}
+		}
+	}
 }
