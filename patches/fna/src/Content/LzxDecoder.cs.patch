+		/* Port: restores the exact state the constructor produces, so one decoder
+		 * can be reused per asset (saves a 64 KB alloc + byte-by-byte fill + 8 table
+		 * allocations on every asset load).
+		 */
+		public void Reset ()
+		{
+			byte[] window = m_state.window;
+			window[0] = 0xDC;
+			int filled = 1;
+			while (filled < window.Length)
+			{
+				int n = Math.Min(filled, window.Length - filled);
+				Buffer.BlockCopy(window, 0, window, filled, n);
+				filled += n;
+			}
+			m_state.window_posn = 0;
+			m_state.R0 = m_state.R1 = m_state.R2 = 1;
+			m_state.header_read = 0;
+			m_state.frames_read = 0;
+			m_state.block_remaining = 0;
+			m_state.block_length = 0;
+			m_state.block_type = LzxConstants.BLOCKTYPE.INVALID;
