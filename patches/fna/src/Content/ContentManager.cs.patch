+		/* Vita port (Stardew Valley): drops the cached assets whose key matches. When dispose is true,
+		 * disposable assets (and a SpriteFont's texture) are disposed immediately so GPU/native memory is
+		 * freed right away; otherwise finalizers free what nothing references any more.
+		 */
+		public int VitaForgetAssets(Predicate<string> match, bool dispose = false)
+		{
+			List<string> keys = new List<string>();
+			foreach (KeyValuePair<string, object> pair in loadedAssets)
+			{
+				if (match(pair.Key))
+				{
+					keys.Add(pair.Key);
+				}
+			}
+			foreach (string key in keys)
+			{
+				VitaRemoveLoadedAsset(key, dispose);
+			}
+			return keys.Count;
+		}
+
+		public bool VitaForgetAsset(string assetName, bool dispose = false)
+		{
+			if (string.IsNullOrEmpty(assetName))
+			{
+				return false;
+			}
+			return VitaRemoveLoadedAsset(assetName.Replace('\\', '/'), dispose);
+		}
+
+		public bool VitaIsKeyLoaded(string key)
+		{
+			return key != null && loadedAssets.ContainsKey(key);
+		}
+
+		public List<string> VitaGetLoadedKeys()
+		{
+			return new List<string>(loadedAssets.Keys);
+		}
+
+		private bool VitaRemoveLoadedAsset(string key, bool dispose)
+		{
+			object asset;
+			if (!loadedAssets.TryGetValue(key, out asset))
+			{
+				return false;
+			}
+			loadedAssets.Remove(key);
+			IDisposable disposable = asset as IDisposable;
+			if (disposable != null)
+			{
+				disposableAssets.Remove(disposable);
+				if (dispose)
+				{
+					disposable.Dispose();
+				}
+			}
+			SpriteFont font = asset as SpriteFont;
+			if (font != null && font.textureValue != null)
+			{
+				disposableAssets.Remove(font.textureValue);
+				if (dispose)
+				{
+					font.textureValue.Dispose();
+				}
+			}
+			return true;
+		}
+
