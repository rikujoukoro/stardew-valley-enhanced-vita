+		/* Vita port (Stardew Valley): a virtual back buffer. With VitaBackBufferScale s set (0 < s < 1)
+		 * and no render target bound, the back buffer reads as BackBuffer / s pixels: Viewport and
+		 * ScissorRectangle take and give that size and SpriteBatch projects it onto the real back
+		 * buffer. The game zooms out by drawing its world into a render target 1/s times the screen
+		 * and scaling that down; at the zooms where an art pixel covers whole screen pixels it now
+		 * draws the same world straight to the screen - the GPU fills s*s of the pixels and skips the
+		 * copy - while every Viewport-sized rectangle of its drawing code still covers what it did.
+		 * Clear and PresentationParameters stay real, as they were with the render target bound.
+		 */
+		private float vitaBackBufferScale;
+		private Viewport vitaVirtualViewport;
+		private Rectangle vitaVirtualScissor;
+
+		/// <summary>Vita port: see above; 0 (the default) turns it off.</summary>
+		public float VitaBackBufferScale
+		{
+			get
+			{
+				return vitaBackBufferScale;
+			}
+			set
+			{
+				if (value == vitaBackBufferScale)
+				{
+					return;
+				}
+				vitaBackBufferScale = (value > 0f && value < 1f) ? value : 0f;
+				if (renderTargetCount == 0)
+				{
+					// The whole back buffer, in the units now in force.
+					int width = VitaFullSize(PresentationParameters.BackBufferWidth);
+					int height = VitaFullSize(PresentationParameters.BackBufferHeight);
+					Viewport = new Viewport(0, 0, width, height);
+					ScissorRectangle = new Rectangle(0, 0, width, height);
+				}
+			}
+		}
+
+		/// <summary>Vita port: whether Viewport and ScissorRectangle are virtual right now.</summary>
+		internal bool VitaVirtual
+		{
+			get
+			{
+				return vitaBackBufferScale > 0f && renderTargetCount == 0;
+			}
+		}
+
+		/// <summary>Vita port: the viewport the device really has (SpriteBatch's projection).</summary>
+		internal Viewport VitaRealViewport
+		{
+			get
+			{
+				return INTERNAL_viewport;
+			}
+		}
+
+		/// <summary>Vita port: a back buffer size in the units in force (virtual: rounded up, so it covers the screen).</summary>
+		private int VitaFullSize(int real)
+		{
+			return vitaBackBufferScale > 0f ? (int) Math.Ceiling(real / vitaBackBufferScale - 0.001f) : real;
+		}
+
+		private Rectangle VitaToReal(Rectangle r)
+		{
+			int x = (int) Math.Round(r.X * vitaBackBufferScale);
+			int y = (int) Math.Round(r.Y * vitaBackBufferScale);
+			int right = Math.Min((int) Math.Round(r.Right * vitaBackBufferScale), PresentationParameters.BackBufferWidth);
+			int bottom = Math.Min((int) Math.Round(r.Bottom * vitaBackBufferScale), PresentationParameters.BackBufferHeight);
+			return new Rectangle(x, y, Math.Max(right - x, 0), Math.Max(bottom - y, 0));
+		}
