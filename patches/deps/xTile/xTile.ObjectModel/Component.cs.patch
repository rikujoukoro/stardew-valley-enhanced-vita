+	// Port: the collection is created on first use. Every tile of every map read at load time used to allocate
+	// one, and almost none ever get a property (tens of thousands of tiles per map, ~80 bytes each).
+	public virtual IPropertyCollection Properties
+	{
+		get
+		{
+			PropertyCollection collection = m_propertyCollection;
+			if (collection == null)
+			{
+				collection = new PropertyCollection();
+				collection = System.Threading.Interlocked.CompareExchange(ref m_propertyCollection, collection, null) ?? collection;
+			}
+			return collection;
+		}
+	}
+
+	/// <summary>Port: the properties for reading, without creating the collection: null when there are none. Reads through <see cref="Properties" /> gave every tile they touched a collection for good.</summary>
